-16T19:30+08:00"},"metrics":{"views":139119,"likes":5679,"reposts":719,"replies":137},"flag":"公司自述","story":{"id":"2111078083813912835","url":"https://x.com/i/trending/2111078083813912835"}},{"title":"可灵 4.0 全面开放：多张参考图拼出新视频","summary":"快手的 AI 视频工具可灵 4.0 已对所有人开放。据 X 热点汇总，能直接生成 30 秒视频、最多 10 个关键帧，还能把最多 15 张图片和视频混在一起当参考。","post":{"id":"2111014728160235719","url":"https://x.com/_lexers/status/2111014728160235719","author":"_lexers","author_name":"LX™","created_at":"2026-10-16T16:41+08:00"},"metrics":{"views":97392,"likes":208,"reposts":227,"replies":24},"flag":"据X热点汇总","story":{"id":"2110908926661206171","url":"https://x.com/i/trending/2110908926661206171"}},{"title":"游戏《明日方舟：终末地》搞 AI 创作活动被骂","summary":"据 X 热点汇总，这款游戏在 B 站推出官方 AI 创作计划，给教程和积分、现金奖励，很多玩家马上反对。有玩家吐槽：这个版本的主题恰好就是画画。提醒：用 AI 做内容，要看粉丝买不买账。","post":{"id":"2111087108802900468","url":"https://x.com/lens_the_martyr/status/2111087108802900468","author":"lens_the_martyr","author_name":"Lens","created_at":"2026-10-16T21:29+08:00"},"metrics":{"views":24214,"likes":857,"reposts":67,"replies":11},"flag":"有争议","story":{"id":"2111113224741392833","url":"https://x.com/i/trending/2111113224741392833"}},{"title":"X 创作者分成门槛：90 天 50 万曝光，很多人卡住","summary":"据 X 热点汇总，X 原创内容分成要 90 天内拿到 50 万次付费用户首页曝光，还要开会员、500 粉、经常发原创。很多中小号在问怎么做到，有 4 万粉的也说三个月够不着。","post":{"id":"2111161045225996343","url":"https://x.com/ralucaroszkos/status/2111161045225996343","author":"ralucaroszkos","author_name":"Raluca Roszkos","created_at":"2026-10-17T02:23+08:00"},"metrics":{"views":1065,"likes":54,"reposts":0,"replies":33},"flag":"据X热点汇总","story":{"id":"2111229495898472722","url":"https://x.com/i/trending/2111229495898472722"}}]},{"id":"tools","name":"实用 AI 工具（免费优先）","icon":"🧰","items":[{"title":"OpenCode 免费送智谱 GLM 5.3 Flash","summary":"开源编程助手 OpenCode 宣布：国产模型 GLM 5.3 Flash 现在在里面免费用；前一天还放出了免费的 DeepSeek V4.1 Flash。适合会一点写代码的人。","post":{"id":"2110986357539754114","url":"https://x.com/opencode/status/2110986357539754114","author":"opencode","author_name":"OpenCode","c